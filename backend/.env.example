# Copy this file to backend/.env and adjust the values. Never commit .env.
# Real environment variables (Docker, CI) override values in this file.

# REQUIRED. Long random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me

# Optional, defaults to False. Use True only on your own machine.
DEBUG=True

# Optional, comma-separated host names the app may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# REQUIRED. Database connection URL.
# Local development: sqlite:///db.sqlite3
# PostgreSQL (Docker Compose, from WFH-04): postgres://user:password@db:5432/workflowhub
DATABASE_URL=sqlite:///db.sqlite3
