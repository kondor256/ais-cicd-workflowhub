# Used by docker-compose.yml. Copy to .env (same folder as docker-compose.yml).
# Never commit .env. This is separate from backend/.env, which is for running without Docker.

# PostgreSQL container (also used to build the backend DATABASE_URL)
POSTGRES_DB=workflowhub
POSTGRES_USER=workflowhub
POSTGRES_PASSWORD=change-me

# Backend. Generate a real key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s) allowed to call the API (CORS), comma-separated, no trailing slash.
# Docker Compose serves the frontend on port 8080.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Frontend build argument: where the browser finds the backend API
VITE_API_URL=http://localhost:8000
